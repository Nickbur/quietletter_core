# ── Quietletter continuity core — production environment ─────────────────────
# Copy to `.env` (`cp env/env.prod .env` or `npm run switch_to_prod`) and fill in every
# REPLACE_ME_* value. `docker compose` reads `.env` automatically. The server refuses to
# start while OWNER_TOKEN, PUBLIC_URL or OWNER_EMAIL still hold their placeholders.

# PostgreSQL connection string.
#   - docker compose (default): the bundled `db` service (compose forces this value).
#   - running against your own Postgres: postgres://user:pass@host:5432/quietletter
DATABASE_URL=postgres://quietletter:quietletter@db:5432/quietletter

# The single owner's bearer token. Every /v1/switches* call must send
#   Authorization: Bearer <OWNER_TOKEN>
# Generate a strong one:  openssl rand -hex 32   (minimum 16 characters)
OWNER_TOKEN=REPLACE_ME

# Public base URL of this instance (no trailing slash). Used to build the release
# links in fire emails and the public-page URLs.
PUBLIC_URL=REPLACE_ME_public_url

# Footer links on the public pages. Running an instance for other people? Point
# PRIVACY_URL / TERMS_URL at your own documents.
DOCS_URL=https://docs.burakov.net/quietletter
PRIVACY_URL=https://burakov.net/projects/quietletter/privacy
TERMS_URL=https://burakov.net/projects/quietletter/terms

# How often the in-process sweep runs, in seconds. 0 disables it (drive it from
# cron instead:  node dist/sweep.js). Keep it small — deadline resolution is minutes.
SWEEP_INTERVAL_SECONDS=60

# How long after firing encrypted payloads + release tokens are kept before the
# retention purge deletes them (also the release-link lifetime), in days.
FIRE_RETENTION_DAYS=90

# HTTP bind.
HOST=0.0.0.0
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# ── Email ────────────────────────────────────────────────────────────────────
# Without SMTP_HOST (or with EMAIL_DEV_MODE=true) email is printed to the console.
# Fire emails carry the recipients' release links, so configure SMTP before relying
# on the instance. Push and SMS are always console-only — the core ships no
# OneSignal/Twilio.

# Where owner check-in warning emails go. Empty ⇒ warnings are console-only.
OWNER_EMAIL=REPLACE_ME_owner_email
# Force console output even if SMTP is configured.
EMAIL_DEV_MODE=false
# SMTP delivery.
SMTP_HOST=REPLACE_ME_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME_smtp_user
SMTP_PASS=REPLACE_ME_smtp_pass
MAIL_FROM=REPLACE_ME_mail_from
